{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist/client",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "reef-research-desk.vercel.app"
        }
      ],
      "destination": "https://getreef.xyz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "reef-research-desk.vercel.app"
        }
      ],
      "destination": "https://getreef.xyz/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:authPath*",
      "destination": "/api/auth-handler?authPath=:authPath*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/auth-handler.js": {
      "maxDuration": 30
    },
    "api/accounts.js": {
      "maxDuration": 30
    },
    "api/notebooks.js": {
      "maxDuration": 30
    },
    "api/auth/[...path].js": {
      "maxDuration": 30
    },
    "api/research.js": {
      "maxDuration": 90,
      "includeFiles": "web/{web_export.json,research/core.mjs}"
    },
    "api/investigate.js": {
      "maxDuration": 90
    }
  }
}
